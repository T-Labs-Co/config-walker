{
    "name": "t-labs-co/config-walker",
    "description": "A centralized configuration walker for Laravel — merge multiple config sources, tag-based scoping, and enum-aware config resolution.",
    "keywords": [
        "t-labs-co",
        "ty-huynh",
        "laravel",
        "config-walker",
        "configuration",
        "config-management"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Ty Huynh",
            "email": "hongty.huynh@gmail.com",
            "homepage": "https://tyhuynh.id.vn",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^12|^13",
        "illuminate/support": "^12|^13"
    },
    "require-dev": {
        "larastan/larastan": "^3",
        "laravel/pint": "^1",
        "orchestra/testbench": "^10|^11",
        "pestphp/pest": "^4|^5",
        "pestphp/pest-plugin-arch": "^3|^4",
        "pestphp/pest-plugin-laravel": "^4|^5"
    },
    "autoload": {
        "psr-4": {
            "TLabsCo\\ConfigWalker\\": "src/"
        },
        "files": [
            "src/Support/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "TLabsCo\\ConfigWalker\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest --parallel",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TLabsCo\\ConfigWalker\\Providers\\ConfigWalkerServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
